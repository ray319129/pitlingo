{
  "_comment": "測試版與正式版 manifest 的差異。tools/build-extension.js 會把這份合併到 manifest.json 產生 dist/pitlingo-test。正式版不讀這份。",
  "name": "PitLingo（測試版）",
  "short_name": "PitLingo 測試",
  "version_name_suffix": "-test",
  "add_permissions": [
    "tabCapture",
    "offscreen"
  ],
  "add_content_scripts_js": {
    "after": "src/content/main.js",
    "files": [
      "src/test/asr-content.js",
      "src/test/danmaku-content.js"
    ]
  },
  "web_accessible_resources": [],
  "add_host_permissions": [
    "https://f1zh-api-test.pitlingo.workers.dev/*"
  ]
}
