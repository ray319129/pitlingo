{
  "manifest_version": 3,
  "name": "PitLingo — F1TV 繁體中文字幕",
  "short_name": "PitLingo",
  "version": "2.0.0",
  "description": "把 F1TV 的英文 CC 翻譯成繁體中文，雙語疊字顯示。開源版：使用你自己的 Anthropic API key。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.formula1.com/*",
    "https://f1prodlive.akamaized.net/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "src/background/sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://f1tv.formula1.com/*"
      ],
      "js": [
        "src/content/inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://f1tv.formula1.com/*"
      ],
      "js": [
        "src/shared/normalize.js",
        "src/shared/defaults.js",
        "src/shared/live-delay.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PitLingo",
    "default_popup": "src/options/options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
